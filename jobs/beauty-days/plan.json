    {
      "start": 28.87,
      "end": 31.22,
      "text": "მოხარული ვიქნებით გაგიცნოთ"
    },
    {
      "start": 31.48,
      "end": 34.27,
      "text": "*14 დღე* — სპეციალური შეთავაზება"
    },
    {
      "start": 34.3,
      "end": 36.45,
      "text": "და შენი დრო საკუთარი თავისთვის"
