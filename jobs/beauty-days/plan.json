      "text": "Verve Beauty Days იწყება"
    },
    {
      "start": 2.45,
      "end": 4.59,
      "text": "ორი კვირის განმავლობაში"
    },
    {
      "start": 4.62,
      "end": 6.79,
      "text": "Verve-ის კოსმეტოლოგიურ პროცედურებზე"
    },
    {
      "start": 6.82,
      "end": 9.22,
      "text": "*20%-იანი* ფასდაკლებით ისარგებლებ"
    },
    {
      "start": 9.48,
      "end": 11.01,
      "text": "კანის ხარისხზე ზრუნვა,"
    },
    {
      "start": 11.04,
      "end": 14.05,
      "text": "შენი ინდივიდუალური საჭიროებების გათვალისწინება"
    },
    {
      "start": 14.08,
      "end": 16.35,
      "text": "და პროფესიონალური ესთეტიკური მიდგომა —"
    },
    {
      "start": 16.61,
      "end": 18.31,
      "text": "სწორედ ეს ქმნის ჩვენთვის"
    },
    {
      "start": 18.34,
      "end": 20.45,
      "text": "თითოეული ვიზიტის მნიშვნელობას"
    },
    {
      "start": 20.73,
      "end": 23.64,
      "text": "თუ დიდი ხანია გეგმავ შენთვის სასურველ პროცედურას"
    },
    {
      "start": 23.67,
      "end": 26.72,
      "text": "ან ჯერ კიდევ ეძებ ადგილს, სადაც საკუთარ თავზე ზრუნვა"
    },
    {
      "start": 26.75,
      "end": 28.84,
      "text": "სასიამოვნო გამოცდილებად იქცევა,"
